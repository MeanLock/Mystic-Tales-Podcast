@model SubscriptionService.BusinessLogic.Models.Mail.PodcastSubscriptionRegistrationRenewalSuccessMailViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subscription Renewal Success - Mystic Tales Podcast</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f3f4f6; color: #1f2937; line-height: 1.6; padding: 20px; min-height: 100vh; }
        .email-container { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); border: 1px solid #e5e7eb; }
        .header { background: linear-gradient(135deg, #84cc16, #a3e635); padding: 40px 30px; text-align: center; }
        .logo { font-size: 28px; font-weight: 700; color: #fff; letter-spacing: -0.5px; }
        .subtitle { color: rgba(255,255,255,0.95); font-size: 14px; margin-top: 8px; }
        .content { padding: 40px 30px; }
        .greeting { font-size: 24px; color: #111827; margin-bottom: 24px; font-weight: 600; }
        .user-name { color: #84cc16; font-weight: 600; }
        .message { color: #4b5563; margin-bottom: 16px; font-size: 16px; line-height: 1.7; }
        .status-box { background: #d1fae5; border-left: 4px solid #10b981; color: #065f46; padding: 20px; margin: 24px 0; border-radius: 0 8px 8px 0; }
        .status-box strong { font-size: 18px; }
        .info-section { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; margin: 24px 0; }
        .info-title { color: #111827; font-size: 16px; font-weight: 600; margin-bottom: 16px; }
        .info-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #e5e7eb; }
        .info-row:last-child { border-bottom: none; }
        .info-label { color: #6b7280; font-weight: 500; }
        .info-value { color: #111827; font-weight: 600; }
        .info-box { background: #fef3c7; border-left: 4px solid #f59e0b; padding: 18px; margin: 24px 0; border-radius: 0 8px 8px 0; color: #78350f; }
        .info-box strong { color: #92400e; }
        .warning-box { background: #fee2e2; border-left: 4px solid #ef4444; padding: 18px; margin: 24px 0; border-radius: 0 8px 8px 0; color: #7f1d1d; }
        .warning-box strong { color: #991b1b; }
        .description-box { background: #f9fafb; border-left: 4px solid #84cc16; padding: 18px; margin: 24px 0; border-radius: 0 8px 8px 0; color: #4b5563; }
        .benefits-section { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 20px; margin: 24px 0; }
        .benefits-title { color: #166534; font-size: 16px; font-weight: 600; margin-bottom: 12px; }
        .benefits-list { list-style: none; padding: 0; }
        .benefits-list li { padding: 8px 0; padding-left: 24px; color: #15803d; position: relative; }
        .benefits-list li:before { content: "✓"; position: absolute; left: 0; color: #22c55e; font-weight: 700; }
        .pricing-section { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; margin: 24px 0; }
        .pricing-title { color: #111827; font-size: 16px; font-weight: 600; margin-bottom: 12px; }
        .price-item { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #e5e7eb; }
        .price-item:last-child { border-bottom: none; }
        .price-label { color: #6b7280; font-weight: 500; }
        .price-value { color: #84cc16; font-weight: 700; font-size: 18px; }
        .footer { background: #f9fafb; padding: 30px; text-align: center; border-top: 1px solid #e5e7eb; }
        .signature { color: #6b7280; }
        .team-name { color: #84cc16; font-weight: 600; }
        @@media (max-width: 600px) { 
            .email-container { margin: 10px; } 
            .content { padding: 30px 20px; } 
            .info-row { flex-direction: column; gap: 4px; }
            .price-item { flex-direction: column; gap: 4px; }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <div class="logo">Mystic Tales Podcast</div>
            <div class="subtitle">Premium Subscription Management</div>
        </div>
        <div class="content">
            <div class="greeting">Hello <span class="user-name">@Model.CustomerFullName</span>,</div>
            <div class="status-box">
                <strong>Renewal Successful</strong><br />
                Your subscription has been successfully renewed!
            </div>
            
            <p class="message">
                Great news! Your subscription payment has been processed successfully and your subscription has been renewed for another cycle.
            </p>
            
            <div class="info-section">
                <div class="info-title">Renewal Details</div>
                <div class="info-row">
                    <span class="info-label">Renewal Date:</span>
                    <span class="info-value">@Model.UpdatedDate.ToString("MMMM dd, yyyy")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Amount Charged:</span>
                    <span class="info-value">$@Model.Price.ToString("N2")</span>
                </div>
            </div>
            
            <div class="info-box">
                <strong>Subscription Status:</strong><br />
                • Your subscription is now active for the new billing cycle<br />
                • Continue enjoying premium content without interruption<br />
                • Your next renewal will be processed automatically<br />
                • You can manage your subscription settings anytime
            </div>
        
        </div>
        <div class="footer">
            <p class="signature">
                Best regards,<br />
                <span class="team-name">Mystic Tales Podcast Team</span>
            </p>
        </div>
    </div>
</body>
</html>