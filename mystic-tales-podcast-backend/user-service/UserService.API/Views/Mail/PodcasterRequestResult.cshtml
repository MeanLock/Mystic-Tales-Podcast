@model UserService.BusinessLogic.Models.Mail.PodcasterRequestResultMailViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Podcaster Application Result - Mystic Tales Podcast</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #f3f4f6;
            color: #1f2937;
            line-height: 1.6;
            padding: 20px;
            min-height: 100vh;
        }
        
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            border: 1px solid #e5e7eb;
        }
        
        .header {
            background: linear-gradient(135deg, #84cc16 0%, #a3e635 100%);
            padding: 40px 30px;
            text-align: center;
        }
        
        .logo {
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.5px;
        }
        
        .subtitle {
            color: rgba(255, 255, 255, 0.95);
            font-size: 14px;
            margin-top: 8px;
            font-weight: 400;
        }
        
        .content {
            padding: 40px 30px;
        }
        
        .greeting {
            font-size: 24px;
            color: #111827;
            margin-bottom: 24px;
            font-weight: 600;
        }
        
        .user-name {
            color: #84cc16;
            font-weight: 600;
        }
        
        .message {
            color: #4b5563;
            margin-bottom: 16px;
            font-size: 16px;
            line-height: 1.7;
        }
        
        .result-section {
            background: #f9fafb;
            border-radius: 10px;
            padding: 30px;
            margin: 30px 0;
            border: 2px solid #84cc16;
            text-align: center;
        }
        
        .result-title {
            color: #111827;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 16px;
        }
        
        .status-approved {
            display: inline-block;
            background: #10b981;
            color: #ffffff;
            font-size: 18px;
            font-weight: 600;
            padding: 14px 32px;
            border-radius: 8px;
            margin: 12px 0;
        }
        
        .status-rejected {
            display: inline-block;
            background: #ef4444;
            color: #ffffff;
            font-size: 18px;
            font-weight: 600;
            padding: 14px 32px;
            border-radius: 8px;
            margin: 12px 0;
        }
        
        .success-section {
            background: #d1fae5;
            border-left: 4px solid #10b981;
            padding: 20px;
            margin: 24px 0;
            border-radius: 0 8px 8px 0;
            color: #065f46;
        }
        
        .success-section strong {
            color: #064e3b;
        }
        
        .rejection-section {
            background: #fee2e2;
            border-left: 4px solid #ef4444;
            padding: 20px;
            margin: 24px 0;
            border-radius: 0 8px 8px 0;
            color: #7f1d1d;
        }
        
        .rejection-section strong {
            color: #991b1b;
        }
        
        .next-steps {
            background: #fef3c7;
            border-left: 4px solid #f59e0b;
            padding: 20px;
            margin: 24px 0;
            border-radius: 0 8px 8px 0;
            color: #78350f;
        }
        
        .next-steps strong {
            color: #92400e;
        }
        
        .steps-list {
            margin: 12px 0;
            padding-left: 20px;
        }
        
        .steps-list li {
            margin-bottom: 6px;
            color: #78350f;
        }
        
        .footer {
            background: #f9fafb;
            padding: 30px;
            text-align: center;
            border-top: 1px solid #e5e7eb;
        }
        
        .signature {
            color: #6b7280;
            font-size: 15px;
        }
        
        .team-name {
            color: #84cc16;
            font-weight: 600;
        }
        
        @@media (max-width: 600px) {
            .email-container {
                margin: 10px;
                border-radius: 10px;
            }
            
            .content {
                padding: 30px 20px;
            }
            
            .header {
                padding: 30px 20px;
            }
            
            .logo {
                font-size: 24px;
            }
            
            .status-approved, .status-rejected {
                font-size: 16px;
                padding: 12px 28px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <div class="logo">Mystic Tales Podcast</div>
            <div class="subtitle">Discover the world of mysterious audio</div>
        </div>
        
        <div class="content">
            <div class="greeting">Hello <span class="user-name">@Model.FullName</span>!</div>
            
            <p class="message">
                We have completed reviewing your application to become a Podcaster on the Mystic Tales Podcast platform. 
                Below is the result for account <strong>@Model.Email</strong>:
            </p>
            
            <div class="result-section">
                <div class="result-title">Review Result</div>
                @if (Model.IsVerified)
                {
                    <div class="status-approved">Approved</div>
                }
                else
                {
                    <div class="status-rejected">Rejected</div>
                }
            </div>
            
            @if (Model.IsVerified)
            {
                <div class="success-section">
                    <strong>Congratulations!</strong><br/>
                    Your application has been approved. You are now officially a member of the Mystic Tales Podcaster family! 
                    We are excited to hear the mysterious stories you will share.
                </div>
                
                <div class="next-steps">
                    <strong>Next Steps:</strong>
                    <ol class="steps-list">
                        <li>Log in to your account to access the Podcaster dashboard</li>
                        <li>Complete your profile and set up your podcast channel</li>
                        <li>Upload your first podcast</li>
                        <li>Start building your listener community</li>
                        <li>Explore analytics and content management tools</li>
                    </ol>
                </div>
                
                <p class="message">
                    We provide comprehensive guidance and support to help you start your podcasting journey easily. 
                    Get ready to create amazing audio content!
                </p>
            }
            else
            {
                <div class="rejection-section">
                    <strong>We're sorry!</strong><br/>
                    After careful consideration, we decided that we cannot approve your application at this time. 
                    This does not mean you cannot become a Podcaster in the future.
                </div>
                
                <div class="next-steps">
                    <strong>Improvement Suggestions:</strong>
                    <ul class="steps-list">
                        <li>Further develop your content ideas and plans</li>
                        <li>Prepare high-quality podcast demo samples</li>
                        <li>Enhance your communication and storytelling skills</li>
                        <li>Learn more about the mysterious podcast market</li>
                        <li>You may reapply after 3 months</li>
                    </ul>
                </div>
                
                <p class="message">
                    We encourage you to continue pursuing your passion and perfecting your skills. 
                    During this time, you can still enjoy thousands of quality podcasts on our platform.
                </p>
            }
        </div>
        
        <div class="footer">
            <p class="signature">
                Best regards,<br />
                <span class="team-name">Mystic Tales Podcast Team</span>
            </p>
        </div>
    </div>
</body>
</html>
