@model UserService.BusinessLogic.Models.Mail.CustomerGoogleRegistrationNewAccountPasswordMailViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Created - Mystic Tales Podcast</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #f3f4f6;
            color: #1f2937;
            line-height: 1.6;
            padding: 20px;
            min-height: 100vh;
        }
        
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            border: 1px solid #e5e7eb;
        }
        
        .header {
            background: linear-gradient(135deg, #84cc16 0%, #a3e635 100%);
            padding: 40px 30px;
            text-align: center;
        }
        
        .logo {
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.5px;
        }
        
        .subtitle {
            color: rgba(255, 255, 255, 0.95);
            font-size: 14px;
            margin-top: 8px;
            font-weight: 400;
        }
        
        .content {
            padding: 40px 30px;
        }
        
        .greeting {
            font-size: 24px;
            color: #111827;
            margin-bottom: 24px;
            font-weight: 600;
        }
        
        .user-name {
            color: #84cc16;
            font-weight: 600;
        }
        
        .message {
            color: #4b5563;
            margin-bottom: 16px;
            font-size: 16px;
            line-height: 1.7;
        }
        
        .password-section {
            background: #f9fafb;
            border-radius: 10px;
            padding: 30px;
            margin: 30px 0;
            border: 2px solid #84cc16;
            text-align: center;
        }
        
        .password-title {
            color: #111827;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 12px;
        }
        
        .password-display {
            display: inline-block;
            background: #84cc16;
            color: #ffffff;
            font-size: 26px;
            font-weight: 700;
            padding: 18px 32px;
            border-radius: 10px;
            letter-spacing: 2px;
            margin: 20px 0;
            font-family: 'Courier New', monospace;
            word-break: break-all;
        }
        
        .account-info {
            background: #f9fafb;
            border-radius: 10px;
            padding: 24px;
            margin: 24px 0;
            border: 1px solid #e5e7eb;
        }
        
        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 14px 0;
            border-bottom: 1px solid #e5e7eb;
        }
        
        .info-row:last-child {
            border-bottom: none;
        }
        
        .info-label {
            color: #6b7280;
            font-weight: 500;
        }
        
        .info-value {
            color: #111827;
            font-weight: 600;
            word-break: break-all;
        }
        
        .info-box {
            background: #fef3c7;
            border-left: 4px solid #f59e0b;
            padding: 18px;
            margin: 24px 0;
            border-radius: 0 8px 8px 0;
            color: #78350f;
        }
        
        .info-box strong {
            color: #92400e;
        }
        
        .welcome-message {
            background: #d1fae5;
            border-left: 4px solid #10b981;
            padding: 18px;
            margin: 24px 0;
            border-radius: 0 8px 8px 0;
            color: #065f46;
        }
        
        .welcome-message strong {
            color: #064e3b;
        }
        
        .security-tip {
            background: #fee2e2;
            border-left: 4px solid #ef4444;
            padding: 18px;
            margin: 24px 0;
            border-radius: 0 8px 8px 0;
            color: #7f1d1d;
        }
        
        .security-tip strong {
            color: #991b1b;
        }
        
        .footer {
            background: #f9fafb;
            padding: 30px;
            text-align: center;
            border-top: 1px solid #e5e7eb;
        }
        
        .signature {
            color: #6b7280;
            font-size: 15px;
        }
        
        .team-name {
            color: #84cc16;
            font-weight: 600;
        }
        
        @@media (max-width: 600px) {
            .email-container {
                margin: 10px;
                border-radius: 10px;
            }
            
            .content {
                padding: 30px 20px;
            }
            
            .header {
                padding: 30px 20px;
            }
            
            .logo {
                font-size: 24px;
            }
            
            .password-display {
                font-size: 20px;
                letter-spacing: 1px;
                padding: 14px 24px;
            }
            
            .info-row {
                flex-direction: column;
                gap: 6px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <div class="logo">Mystic Tales Podcast</div>
            <div class="subtitle">Discover the world of mysterious audio</div>
        </div>
        
        <div class="content">
            <div class="greeting">Hello <span class="user-name">@Model.FullName</span>!</div>
            
            <div class="welcome-message">
                <strong>Welcome to Mystic Tales Podcast!</strong><br/>
                Your account has been successfully created via Google Sign-In. We're excited to have you join our community of mysterious podcast enthusiasts!
            </div>
            
            <p class="message">
                We've generated a secure password for your account. You can use this password to sign in with your email address if you prefer not to use Google Sign-In in the future.
            </p>
            
            <div class="account-info">
                <div class="info-row">
                    <span class="info-label">Email Address:</span>
                    <span class="info-value">@Model.Email</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Full Name:</span>
                    <span class="info-value">@Model.FullName</span>
                </div>
            </div>
            
            <div class="password-section">
                <div class="password-title">Your Account Password</div>
                <p style="color: #6b7280; margin-bottom: 20px; font-size: 14px;">
                    Save this password securely - you'll need it to sign in
                </p>
                <div class="password-display">@Model.NewAccountPassword</div>
            </div>
            
            <div class="security-tip">
                <strong>Security Recommendations:</strong><br/>
                • Please change this password after your first login<br/>
                • Store this password in a secure password manager<br/>
                • Never share your password with anyone<br/>
                • Enable two-factor authentication for extra security
            </div>
            
            <div class="info-box">
                <strong>Getting Started:</strong><br/>
                • You can sign in using Google or your email + password<br/>
                • Explore thousands of mysterious and captivating podcasts<br/>
                • Create playlists and follow your favorite podcasters<br/>
                • Join our vibrant community of mystery enthusiasts
            </div>
            
            <p class="message">
                If you did not create this account or have any questions, please contact our support team immediately.
            </p>
        </div>
        
        <div class="footer">
            <p class="signature">
                Best regards,<br />
                <span class="team-name">Mystic Tales Podcast Team</span>
            </p>
        </div>
    </div>
</body>
</html>
