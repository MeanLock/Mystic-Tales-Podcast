@model UserService.BusinessLogic.Models.Mail.PodcasterRequestConfirmationMailViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Podcaster Registration Confirmation - Mystic Tales Podcast</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #f3f4f6;
            color: #1f2937;
            line-height: 1.6;
            padding: 20px;
            min-height: 100vh;
        }
        
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            border: 1px solid #e5e7eb;
        }
        
        .header {
            background: linear-gradient(135deg, #84cc16 0%, #a3e635 100%);
            padding: 40px 30px;
            text-align: center;
        }
        
        .logo {
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.5px;
        }
        
        .subtitle {
            color: rgba(255, 255, 255, 0.95);
            font-size: 14px;
            margin-top: 8px;
            font-weight: 400;
        }
        
        .content {
            padding: 40px 30px;
        }
        
        .greeting {
            font-size: 24px;
            color: #111827;
            margin-bottom: 24px;
            font-weight: 600;
        }
        
        .user-name {
            color: #84cc16;
            font-weight: 600;
        }
        
        .message {
            color: #4b5563;
            margin-bottom: 16px;
            font-size: 16px;
            line-height: 1.7;
        }
        
        .confirmation-section {
            background: #f9fafb;
            border-radius: 10px;
            padding: 30px;
            margin: 30px 0;
            border: 2px solid #84cc16;
            text-align: center;
        }
        
        .confirmation-title {
            color: #111827;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 16px;
        }
        
        .status-badge {
            display: inline-block;
            background: #84cc16;
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            padding: 12px 28px;
            border-radius: 8px;
            margin: 12px 0;
        }
        
        .info-section {
            background: #dbeafe;
            border-left: 4px solid #3b82f6;
            padding: 20px;
            margin: 24px 0;
            border-radius: 0 8px 8px 0;
            color: #1e3a8a;
        }
        
        .info-section strong {
            color: #1e40af;
        }
        
        .info-section ul {
            margin: 12px 0;
            padding-left: 20px;
        }
        
        .info-section li {
            margin-bottom: 6px;
            color: #1e3a8a;
        }
        
        .next-steps {
            background: #fef3c7;
            border-left: 4px solid #f59e0b;
            padding: 20px;
            margin: 24px 0;
            border-radius: 0 8px 8px 0;
            color: #78350f;
        }
        
        .next-steps strong {
            color: #92400e;
        }
        
        .steps-list {
            margin: 12px 0;
            padding-left: 20px;
        }
        
        .steps-list li {
            margin-bottom: 6px;
            color: #78350f;
        }
        
        .footer {
            background: #f9fafb;
            padding: 30px;
            text-align: center;
            border-top: 1px solid #e5e7eb;
        }
        
        .signature {
            color: #6b7280;
            font-size: 15px;
        }
        
        .team-name {
            color: #84cc16;
            font-weight: 600;
        }
        
        @@media (max-width: 600px) {
            .email-container {
                margin: 10px;
                border-radius: 10px;
            }
            
            .content {
                padding: 30px 20px;
            }
            
            .header {
                padding: 30px 20px;
            }
            
            .logo {
                font-size: 24px;
            }
            
            .status-badge {
                font-size: 14px;
                padding: 10px 24px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <div class="logo">Mystic Tales Podcast</div>
            <div class="subtitle">Discover the world of mysterious audio</div>
        </div>
        
        <div class="content">
            <div class="greeting">Hello <span class="user-name">@Model.FullName</span>!</div>
            
            <p class="message">
                Thank you for submitting your request to become a Podcaster on the Mystic Tales Podcast platform. We have received your application and are excited about the podcast ideas you want to share.
            </p>
            
            <div class="confirmation-section">
                <div class="confirmation-title">Application Status</div>
                <div class="status-badge">Request Received</div>
                <p style="color: #6b7280; margin-top: 16px; font-size: 14px;">
                    Your request has been registered for account: <strong style="color: #111827;">@Model.Email</strong>
                </p>
            </div>
            
            <div class="info-section">
                <strong>Review Process:</strong><br/>
                Our team will review your profile and podcast ideas within 3-5 business days. We will evaluate based on:
                <ul>
                    <li>Content quality and ideas</li>
                    <li>Alignment with platform direction</li>
                    <li>Experience and communication skills</li>
                </ul>
            </div>
            
            <div class="next-steps">
                <strong>Next Steps:</strong>
                <ol class="steps-list">
                    <li>We will review your application</li>
                    <li>You will receive an email with the results</li>
                    <li>If approved, you will gain access to the Podcaster dashboard</li>
                    <li>You can start creating and publishing your first podcast</li>
                </ol>
            </div>
            
            <p class="message">
                While waiting, you can still use all podcast listening features as a regular user. Thank you for trusting and choosing Mystic Tales Podcast!
            </p>
        </div>
        
        <div class="footer">
            <p class="signature">
                Best regards,<br />
                <span class="team-name">Mystic Tales Podcast Team</span>
            </p>
        </div>
    </div>
</body>
</html>
