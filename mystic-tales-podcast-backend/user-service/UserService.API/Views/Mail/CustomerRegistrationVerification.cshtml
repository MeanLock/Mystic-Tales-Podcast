@model UserService.BusinessLogic.Models.Mail.CustomerRegistrationVerificationMailViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Verification - Mystic Tales Podcast</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #f3f4f6;
            color: #1f2937;
            line-height: 1.6;
            padding: 20px;
            min-height: 100vh;
        }
        
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            border: 1px solid #e5e7eb;
        }
        
        .header {
            background: linear-gradient(135deg, #84cc16 0%, #a3e635 100%);
            padding: 40px 30px;
            text-align: center;
        }
        
        .logo {
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.5px;
        }
        
        .subtitle {
            color: rgba(255, 255, 255, 0.95);
            font-size: 14px;
            margin-top: 8px;
            font-weight: 400;
        }
        
        .content {
            padding: 40px 30px;
        }
        
        .greeting {
            font-size: 24px;
            color: #111827;
            margin-bottom: 24px;
            font-weight: 600;
        }
        
        .user-name {
            color: #84cc16;
            font-weight: 600;
        }
        
        .message {
            color: #4b5563;
            margin-bottom: 16px;
            font-size: 16px;
            line-height: 1.7;
        }
        
        .verification-section {
            background: #f9fafb;
            border-radius: 10px;
            padding: 30px;
            margin: 30px 0;
            border: 2px solid #84cc16;
            text-align: center;
        }
        
        .verification-title {
            color: #111827;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 12px;
        }
        
        .verify-code {
            display: inline-block;
            background: #84cc16;
            color: #ffffff;
            font-size: 32px;
            font-weight: 700;
            padding: 20px 40px;
            border-radius: 10px;
            letter-spacing: 8px;
            margin: 20px 0;
            font-family: 'Courier New', monospace;
        }
        
        .info-box {
            background: #fef3c7;
            border-left: 4px solid #f59e0b;
            padding: 18px;
            margin: 24px 0;
            border-radius: 0 8px 8px 0;
            color: #78350f;
        }
        
        .info-box strong {
            color: #92400e;
        }
        
        .welcome-message {
            background: #d1fae5;
            border-left: 4px solid #10b981;
            padding: 18px;
            margin: 24px 0;
            border-radius: 0 8px 8px 0;
            color: #065f46;
        }
        
        .welcome-message strong {
            color: #064e3b;
        }
        
        .footer {
            background: #f9fafb;
            padding: 30px;
            text-align: center;
            border-top: 1px solid #e5e7eb;
        }
        
        .signature {
            color: #6b7280;
            font-size: 15px;
        }
        
        .team-name {
            color: #84cc16;
            font-weight: 600;
        }
        
        @@media (max-width: 600px) {
            .email-container {
                margin: 10px;
                border-radius: 10px;
            }
            
            .content {
                padding: 30px 20px;
            }
            
            .header {
                padding: 30px 20px;
            }
            
            .logo {
                font-size: 24px;
            }
            
            .verify-code {
                font-size: 26px;
                letter-spacing: 4px;
                padding: 16px 30px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <div class="logo">Mystic Tales Podcast</div>
            <div class="subtitle">Discover the world of mysterious audio</div>
        </div>
        
        <div class="content">
            <div class="greeting">Hello <span class="user-name">@Model.FullName</span>!</div>
            
            <div class="welcome-message">
                <strong>Welcome to Mystic Tales Podcast!</strong><br/>
                Thank you for registering an account. We are excited to welcome you to our community of mysterious podcast enthusiasts.
            </div>
            
            <p class="message">
                To complete your registration and activate your account <strong>@Model.Email</strong>, please use the verification code below:
            </p>
            
            <div class="verification-section">
                <div class="verification-title">Account Verification Code</div>
                <p style="color: #6b7280; margin-bottom: 20px; font-size: 14px;">
                    Enter this code on the verification page to complete your registration
                </p>
                <div class="verify-code">@Model.VerifyCode</div>
            </div>
            
            <div class="info-box">
                <strong>Important Note:</strong><br/>
                • This verification code is valid for 15 minutes<br/>
                • Do not share this code with anyone<br/>
                • If you did not make this request, please ignore this email
            </div>
            
            <p class="message">
                After successful verification, you will be able to access all Mystic Tales Podcast features and explore thousands of fascinating podcasts!
            </p>
        </div>
        
        <div class="footer">
            <p class="signature">
                Best regards,<br />
                <span class="team-name">Mystic Tales Podcast Team</span>
            </p>
        </div>
    </div>
</body>
</html>
