@model ModerationService.BusinessLogic.Models.Mail.DMCANoticeValidToAccusedMailViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DMCA Takedown Notice - Mystic Tales Podcast</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f3f4f6; color: #1f2937; line-height: 1.6; padding: 20px; min-height: 100vh; }
        .email-container { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); border: 1px solid #e5e7eb; }
        .header { background: linear-gradient(135deg, #84cc16, #a3e635); padding: 40px 30px; text-align: center; }
        .logo { font-size: 28px; font-weight: 700; color: #fff; letter-spacing: -0.5px; }
        .subtitle { color: rgba(255,255,255,0.95); font-size: 14px; margin-top: 8px; }
        .content { padding: 40px 30px; }
        .greeting { font-size: 24px; color: #111827; margin-bottom: 24px; font-weight: 600; }
        .user-name { color: #84cc16; font-weight: 600; }
        .message { color: #4b5563; margin-bottom: 16px; font-size: 16px; line-height: 1.7; }
        .status-box { background: #fef3c7; border-left: 4px solid #f59e0b; color: #78350f; padding: 20px; margin: 24px 0; border-radius: 0 8px 8px 0; }
        .status-box strong { font-size: 18px; }
        .info-section { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; margin: 24px 0; }
        .info-title { color: #111827; font-size: 16px; font-weight: 600; margin-bottom: 16px; }
        .info-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #e5e7eb; }
        .info-row:last-child { border-bottom: none; }
        .info-label { color: #6b7280; font-weight: 500; }
        .info-value { color: #111827; font-weight: 600; word-break: break-word; }
        .info-box { background: #fef3c7; border-left: 4px solid #f59e0b; padding: 18px; margin: 24px 0; border-radius: 0 8px 8px 0; color: #78350f; }
        .info-box strong { color: #92400e; }
        .warning-box { background: #fee2e2; border-left: 4px solid #ef4444; padding: 18px; margin: 24px 0; border-radius: 0 8px 8px 0; color: #7f1d1d; }
        .warning-box strong { color: #991b1b; }
        .attachment-section { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; margin: 24px 0; }
        .attachment-title { color: #111827; font-size: 16px; font-weight: 600; margin-bottom: 12px; }
        .attachment-list { list-style: none; padding: 0; }
        .attachment-list li { padding: 10px; margin-bottom: 8px; background: #fff; border: 1px solid #e5e7eb; border-radius: 6px; }
        .attachment-list a { color: #3b82f6; text-decoration: none; word-break: break-all; }
        .footer { background: #f9fafb; padding: 30px; text-align: center; border-top: 1px solid #e5e7eb; }
        .signature { color: #6b7280; }
        .team-name { color: #84cc16; font-weight: 600; }
        @@media (max-width: 600px) { 
            .email-container { margin: 10px; } 
            .content { padding: 30px 20px; } 
            .info-row { flex-direction: column; gap: 4px; }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <div class="logo">Mystic Tales Podcast</div>
            <div class="subtitle">Content Protection & Copyright Management</div>
        </div>
        <div class="content">
            <div class="greeting">Hello <span class="user-name">@Model.PodcasterFullName</span>,</div>
            <div class="status-box">
                <strong>DMCA Takedown Notice Filed</strong><br />
                A valid DMCA takedown notice has been filed against your content.
            </div>
            
            <p class="message">
                We have received a valid Digital Millennium Copyright Act (DMCA) takedown notice regarding content associated with your account.
            </p>
            
            <div class="info-section">
                <div class="info-title">Notice Details</div>
                <div class="info-row">
                    <span class="info-label">Validated Date:</span>
                    <span class="info-value">@Model.ValidatedAt.ToString("MMMM dd, yyyy")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Response Deadline:</span>
                    <span class="info-value">@Model.TimeToResponse days from validation</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Your Email:</span>
                    <span class="info-value">@Model.PodcasterEmail</span>
                </div>
            </div>
            
            @if (Model.AttachmentFileUrls != null && Model.AttachmentFileUrls.Any())
            {
                <div class="attachment-section">
                    <div class="attachment-title">Supporting Documentation</div>
                    <ul class="attachment-list">
                        @foreach (var fileUrl in Model.AttachmentFileUrls)
                        {
                            <li><a href="@fileUrl" target="_blank">@fileUrl</a></li>
                        }
                    </ul>
                </div>
            }
            
            <div class="warning-box">
                <strong>Action Required:</strong><br />
                • Your content has been temporarily removed<br />
                • You may accept the claim or file a counter-notice<br />
                • Response deadline: @Model.TimeToResponse days<br />
                • Consider seeking legal counsel
            </div>
        
        </div>
        <div class="footer">
            <p class="signature">
                Best regards,<br />
                <span class="team-name">Mystic Tales Podcast Legal Team</span>
            </p>
        </div>
    </div>
</body>
</html>